# Atlazora repository text normalization
#
# Git stores text files with LF line endings.
# Developers may use Windows, Linux, or macOS working trees.

* text=auto eol=lf

# Explicit text formats
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf

# Binary formats
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
